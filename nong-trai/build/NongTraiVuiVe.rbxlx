            <string name="Name">Crops</string>
            <string name="Source"><![CDATA[--[[
	Danh sách cây trồng. Dữ liệu thuần (không dùng kiểu Roblox) để chạy được test.

	Season   : mùa trồng được ("Xuân" | "Hạ" | "Thu" | "Đông")
	Days     : số ngày được tưới cần để chín
	SeedPrice: giá 1 hạt   | SellPrice: giá bán 1 nông sản 1 sao
	Regrow   : (tuỳ chọn) cây thu nhiều lần, ra quả lại sau bấy nhiêu ngày
	Color    : {r, g, b} màu nông sản
	Shape    : hình khi chín: "ball" | "root" | "tall" | "leafy" | "bush"
	Size     : (tuỳ chọn) độ to của nông sản khi Shape = "ball"
]]

local Crops = {}

Crops.Order = {
	"RauMuong", "CaRot", "DauTay",
	"Ngo", "DuaHau", "ThanhLong",
	"KhoaiLang", "LuaNuoc", "BiNgo",
	"CuCaiTrang", "SuHao", "CaiBap",
}

Crops.List = {
	-- Xuân
	RauMuong = { Name = "Rau muống", Season = "Xuân", Days = 2, SeedPrice = 10, SellPrice = 25, Color = { 76, 175, 80 }, Shape = "leafy" },
	CaRot = { Name = "Cà rốt", Season = "Xuân", Days = 3, SeedPrice = 20, SellPrice = 50, Color = { 255, 140, 40 }, Shape = "root" },
	DauTay = { Name = "Dâu tây", Season = "Xuân", Days = 4, SeedPrice = 60, SellPrice = 45, Regrow = 2, Color = { 229, 57, 80 }, Shape = "bush" },
	-- Hạ
	Ngo = { Name = "Ngô", Season = "Hạ", Days = 4, SeedPrice = 30, SellPrice = 80, Color = { 244, 196, 48 }, Shape = "tall" },
	DuaHau = { Name = "Dưa hấu", Season = "Hạ", Days = 6, SeedPrice = 80, SellPrice = 240, Color = { 62, 158, 74 }, Shape = "ball", Size = 2.8 },
	ThanhLong = { Name = "Thanh long", Season = "Hạ", Days = 5, SeedPrice = 120, SellPrice = 90, Regrow = 3, Color = { 224, 64, 138 }, Shape = "bush" },
	-- Thu
	KhoaiLang = { Name = "Khoai lang", Season = "Thu", Days = 4, SeedPrice = 35, SellPrice = 95, Color = { 156, 79, 122 }, Shape = "root" },
	LuaNuoc = { Name = "Lúa nước", Season = "Thu", Days = 5, SeedPrice = 40, SellPrice = 120, Color = { 217, 194, 90 }, Shape = "tall" },
	BiNgo = { Name = "Bí ngô", Season = "Thu", Days = 6, SeedPrice = 90, SellPrice = 270, Color = { 255, 122, 0 }, Shape = "ball", Size = 2.6 },
	-- Đông
	CuCaiTrang = { Name = "Củ cải trắng", Season = "Đông", Days = 2, SeedPrice = 15, SellPrice = 38, Color = { 242, 242, 242 }, Shape = "root" },
	SuHao = { Name = "Su hào", Season = "Đông", Days = 3, SeedPrice = 25, SellPrice = 65, Color = { 139, 199, 122 }, Shape = "ball", Size = 1.7 },
	CaiBap = { Name = "Cải bắp", Season = "Đông", Days = 4, SeedPrice = 45, SellPrice = 120, Color = { 111, 191, 94 }, Shape = "ball", Size = 2.3 },
}

return Crops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--[[
	Thông số chung của game. Dữ liệu thuần (không dùng kiểu Roblox) để chạy được test.
	Muốn cân bằng lại game: sửa các con số ở đây.
]]

local Game = {}

Game.DataStoreName = "NongTraiVuiVe_v1" -- đổi tên = xoá sạch tiến trình mọi người

-- ===== Người chơi mới =====
Game.StartingCoins = 100
Game.StartingSeedCount = 6 -- tặng 6 hạt cây rẻ nhất của mùa hiện tại
Game.StartingFertilizer = 3

-- ===== Thời gian =====
Game.Time = {
	DayLength = 720, -- 1 ngày trong game = 720 giây thật (12 phút)
	DaysPerSeason = 7,
	Seasons = { "Xuân", "Hạ", "Thu", "Đông" },
	DawnHour = 6, -- ngày mới bắt đầu lúc 6:00 sáng
	Epoch = 1735689600, -- mốc tính lịch (mọi server dùng chung một lịch)
}

-- ===== Công cụ =====
Game.ToolOrder = { "Hoe", "WateringCan", "SeedBag", "Sickle", "Fertilizer", "Sprayer" }
Game.Tools = {
	Hoe = { Name = "Cuốc" },
	WateringCan = { Name = "Bình tưới" },
	SeedBag = { Name = "Túi hạt" },
	Sickle = { Name = "Liềm" },
	Fertilizer = { Name = "Phân bón" },
	Sprayer = { Name = "Bình xịt" },
}
Game.ToolRange = 16 -- khoảng cách tối đa (stud) từ nhân vật tới ô đất
Game.ToolCooldown = 0.2 -- giây giữa 2 lần dùng công cụ

-- ===== Đất & cây =====
Game.WaterCapacity = 15 -- số lần tưới mỗi bình
Game.DebrisHp = 3 -- số nhát cuốc để dọn đá/gốc cây
Game.Fertility = {
	Start = 50,
	HarvestCost = 15, -- mỗi lần thu hoạch đất mất bấy nhiêu màu mỡ
	FertilizerGain = 40,
	Good = 60, -- từ mức này trở lên được tính là "đất tốt"
}
Game.WeedChancePerHour = 0.01 -- xác suất cỏ mọc mỗi giờ trong game (mỗi ô)
Game.PestChancePerHour = 0.006 -- xác suất sâu xuất hiện mỗi giờ trong game (mỗi cây)
Game.QualityMultiplier = { 1, 1.25, 1.5 } -- giá bán theo số sao

-- ===== Cửa hàng =====
Game.FertilizerPrice = 25

-- ===== Đảo =====
Game.MaxIslands = 8
Game.TileSize = 4
-- Các khu đất trên đảo (toạ độ tính từ tâm đảo, đơn vị stud)
Game.Zones = {
	{ Id = 1, Name = "Khu 1", Cols = 6, Rows = 6, X = -36, Z = -24, Price = 0, DebrisChance = 0.15 },
	{ Id = 2, Name = "Khu 2", Cols = 4, Rows = 6, X = -8, Z = -24, Price = 500, DebrisChance = 0.35 },
	{ Id = 3, Name = "Khu 3", Cols = 6, Rows = 4, X = -36, Z = 6, Price = 1500, DebrisChance = 0.35 },
	{ Id = 4, Name = "Khu 4", Cols = 4, Rows = 4, X = -8, Z = 6, Price = 4000, DebrisChance = 0.4 },
}

return Game
]]></string>
          </Properties>
